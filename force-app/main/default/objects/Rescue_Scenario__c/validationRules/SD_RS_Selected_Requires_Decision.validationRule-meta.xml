<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SD_RS_Selected_Requires_Decision</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    Selected__c,
    OR(
        ISBLANK(Decision_By__c),
        ISBLANK(Decision_Date__c)
    )
)</errorConditionFormula>
    <errorMessage>A selected scenario requires the decision user and decision date.</errorMessage>
</ValidationRule>
