<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SD_INV_Quantities_Cannot_Be_Negative</fullName>
    <active>true</active>
    <errorConditionFormula>OR(
    Available_Quantity__c &lt; 0,
    Reserved_Quantity__c &lt; 0
)</errorConditionFormula>
    <errorMessage>Inventory quantities cannot be negative.</errorMessage>
</ValidationRule>
