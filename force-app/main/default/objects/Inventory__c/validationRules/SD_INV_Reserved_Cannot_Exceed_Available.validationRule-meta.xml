<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SD_INV_Reserved_Cannot_Exceed_Available</fullName>
    <active>true</active>
    <errorConditionFormula>Reserved_Quantity__c &gt; Available_Quantity__c</errorConditionFormula>
    <errorDisplayField>Reserved_Quantity__c</errorDisplayField>
    <errorMessage>Reserved quantity cannot exceed available quantity.</errorMessage>
</ValidationRule>
