<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Resolved_closed_required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISCHANGED(Status__c), ISPICKVAL(Status__c,&quot;Closed&quot;),
NOT(ISPICKVAL(PRIORVALUE(Status__c),&quot;Resolved&quot;)))</errorConditionFormula>
    <errorDisplayField>Status__c</errorDisplayField>
    <errorMessage>interdit de choisir Closed si le statut précédent n&apos;était pas
Resolved</errorMessage>
</ValidationRule>
