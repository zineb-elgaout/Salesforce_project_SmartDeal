<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Critical_Needs_Assignee</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Priority__c,&quot;Critical&quot;),
ISBLANK(Assigned_To__c))</errorConditionFormula>
    <errorDisplayField>Assigned_To__c</errorDisplayField>
    <errorMessage>Une demande Critical doit être assignée à un
responsable.</errorMessage>
</ValidationRule>
