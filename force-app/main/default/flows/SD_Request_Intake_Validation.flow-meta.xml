<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Deja_en_revue</name>
        <label>Déjà en revue ?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Mettre_a_jour_vers_Needs_Review</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Non</defaultConnectorLabel>
        <rules>
            <name>oui_en_revue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Validation_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Needs Review</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Missing_Information__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>varMissingInformation</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>END_ELEMENT_4</targetReference>
            </connector>
            <label>Oui</label>
        </rules>
    </decisions>
    <decisions>
        <name>Deja_prete</name>
        <label>Déjà prête ?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Mettre_a_jour_vers_Ready</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Non</defaultConnectorLabel>
        <rules>
            <name>Oui</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Validation_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Ready for Validation</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Missing_Information__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>END_ELEMENT_2</targetReference>
            </connector>
            <label>Oui</label>
        </rules>
    </decisions>
    <decisions>
        <name>Demande_complete</name>
        <label>Demande complète ?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Deja_en_revue</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Incomplete</defaultConnectorLabel>
        <rules>
            <name>Complete</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Requested_Product__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Requested_Quantity__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Requested_Quantity__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Delivery_City__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Requested_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Requested_Date__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>varToday</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Budget__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Budget__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Opportunity__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Consent_Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>OptOut</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Deja_prete</targetReference>
            </connector>
            <label>Complete</label>
        </rules>
    </decisions>
    <description>Valide les informations d&apos;une demande client et prépare la revue humaine.</description>
    <ends>
        <name>END_ELEMENT_1</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <ends>
        <name>END_ELEMENT_2</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <ends>
        <name>END_ELEMENT_3</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <ends>
        <name>END_ELEMENT_4</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <environments>Default</environments>
    <formulas>
        <description>Liste des informations manquantes ou bloquantes</description>
        <name>varMissingInformation</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.Requested_Product__c}), &quot;Produit; &quot;, &quot;&quot;)
&amp; IF(ISBLANK({!$Record.Requested_Quantity__c}) || {!$Record.Requested_Quantity__c} &lt;= 0, &quot;Quantité; &quot;, &quot;&quot;)
&amp; IF(ISBLANK({!$Record.Delivery_City__c}), &quot;Ville de livraison; &quot;, &quot;&quot;)
&amp; IF(ISBLANK({!$Record.Requested_Date__c}) || {!$Record.Requested_Date__c} &lt; TODAY(), &quot;Date demandée; &quot;, &quot;&quot;)
&amp; IF(ISBLANK({!$Record.Budget__c}) || {!$Record.Budget__c} &lt; 0, &quot;Budget; &quot;, &quot;&quot;)
&amp; IF(ISBLANK({!$Record.Opportunity__c}), &quot;Opportunité; &quot;, &quot;&quot;)
&amp; IF(ISPICKVAL({!$Record.Consent_Status__c}, &quot;OptOut&quot;), &quot;Consentement OptOut; &quot;, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>varTaskComments</name>
        <dataType>String</dataType>
        <expression>&quot;Vérifier la demande, le produit, la quantité, la ville, la date et le budget avant validation.&quot;</expression>
    </formulas>
    <formulas>
        <name>varTaskSubject</name>
        <dataType>String</dataType>
        <expression>&quot;Valider la demande &quot; &amp; {!$Record.Name}</expression>
    </formulas>
    <formulas>
        <description>Date du jour</description>
        <name>varToday</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <interviewLabel>SD Request Intake Validation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SD Request Intake Validation</label>
    <processMetadataValues>
