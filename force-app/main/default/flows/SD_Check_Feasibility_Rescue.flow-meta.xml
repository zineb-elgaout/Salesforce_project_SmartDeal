    <formulas>
        <name>varAssumptions</name>
        <dataType>String</dataType>
        <expression>&quot;Scénario généré depuis Inventory. Ville=&quot; &amp; {!Loop_Inventory.City__c}
&amp; &quot;; quantité disponible=&quot; &amp; TEXT({!Loop_Inventory.Usable_Quantity__c})
&amp; &quot;; quantité proposée=&quot; &amp; TEXT({!varProposedQuantity})
&amp; &quot;; livraison estimée=&quot; &amp; TEXT({!varEstimatedDelivery})
&amp; &quot;; prix unitaire=&quot; &amp; TEXT({!Loop_Inventory.Unit_Price__c})
&amp; &quot;; fraîcheur=&quot; &amp; TEXT({!Loop_Inventory.Last_Updated__c})
&amp; &quot;. Vérification humaine requise; aucun ordre ni réservation.&quot;</expression>
    </formulas>
    <formulas>
        <name>varAvailabilityScore</name>
        <dataType>Number</dataType>
        <expression>MIN(100, ({!varProposedQuantity} / {!$Record.Requested_Quantity__c}) * 100)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>varDaysUntilRequested</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Requested_Date__c} - TODAY()</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>varEcoScore</name>
        <dataType>Number</dataType>
        <expression>IF({!Loop_Inventory.Is_Reconditioned__c}, 80, 50)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>varEstimatedDelivery</name>
        <dataType>Date</dataType>
        <expression>TODAY() + {!Loop_Inventory.Lead_Time_Days__c}</expression>
    </formulas>
    <formulas>
        <name>varEstimatedTotal</name>
        <dataType>Number</dataType>
        <expression>{!Loop_Inventory.Unit_Price__c} * {!$Record.Requested_Quantity__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>varFreshCutoff</name>
        <dataType>DateTime</dataType>
        <expression>NOW() - 1</expression>
    </formulas>
    <formulas>
        <name>varMaxUnitPrice</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Budget__c} / {!$Record.Requested_Quantity__c}</expression>
        <scale>4</scale>
    </formulas>
    <formulas>
        <name>varNoScenarioTaskComments</name>
        <dataType>String</dataType>
        <expression>&quot;Aucun stock actif et frais ne permet de créer un scénario. Vérifier l&apos;inventaire ou proposer une alternative.&quot;</expression>
    </formulas>
    <formulas>
        <name>varNoScenarioTaskSubject</name>
        <dataType>String</dataType>
        <expression>&quot;Aucun scénario pour &quot; &amp; {!$Record.Name}</expression>
    </formulas>
    <formulas>
        <name>varProposedQuantity</name>
        <dataType>Number</dataType>
        <expression>MIN(
  {!Loop_Inventory.Usable_Quantity__c},
  {!$Record.Requested_Quantity__c},
  IF(
    {!Loop_Inventory.Unit_Price__c} &gt; 0,
    FLOOR({!$Record.Budget__c} / {!Loop_Inventory.Unit_Price__c}),
    {!$Record.Requested_Quantity__c}
  )
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>varScenarioTaskComments</name>
        <dataType>String</dataType>
        <expression>&quot;Scénarios générés: &quot; &amp; TEXT({!varScenarioCount})
&amp; &quot;. Vérifier les hypothèses, la compatibilité produit et la fraîcheur des données avant décision.&quot;</expression>
    </formulas>
    <formulas>
        <name>varScenarioTaskSubject</name>
        <dataType>String</dataType>
        <expression>&quot;Examiner les scénarios pour &quot; &amp; {!$Record.Name}</expression>
    </formulas>
    <formulas>
        <name>varScenarioType</name>
        <dataType>String</dataType>
        <expression>IF(
  {!Loop_Inventory.Usable_Quantity__c} &lt; {!$Record.Requested_Quantity__c}
  || {!varEstimatedTotal} &gt; {!$Record.Budget__c},
  &quot;Partial Delivery&quot;,
  IF(
    {!Loop_Inventory.Is_Reconditioned__c},
    &quot;Reconditioned Product&quot;,
    IF(
      {!Loop_Inventory.City__c} &lt;&gt; {!$Record.Delivery_City__c},
      &quot;Other Warehouse&quot;,
      IF(
        {!varEstimatedDelivery} &gt; {!$Record.Requested_Date__c},
        &quot;Adjusted Date&quot;,
        &quot;Other Warehouse&quot;
      )
    )
  )
)</expression>
    </formulas>
    <formulas>
        <name>varScoreExplanation</name>
        <dataType>String</dataType>
        <expression>&quot;Score &quot; &amp; {!varWeight.Version__c}
&amp; &quot;: Availability=&quot; &amp; TEXT({!varAvailabilityScore})
&amp; &quot;; Service=&quot; &amp; TEXT({!varServiceScore})
&amp; &quot;; Margin=50; Eco=&quot; &amp; TEXT({!varEcoScore})
&amp; &quot;; Priority=50; Final=&quot; &amp; TEXT({!varTotalScore}) &amp; &quot;.&quot;</expression>
    </formulas>
    <formulas>
        <name>varServiceScore</name>
        <dataType>Number</dataType>
        <expression>IF({!varEstimatedDelivery} &lt;= {!$Record.Requested_Date__c}, 100, 50)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>varToday</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <formulas>
        <name>varTotalScore</name>
        <dataType>Number</dataType>
        <expression>MIN(100, MAX(0,
({!varWeight.Availability_Weight__c} * {!varAvailabilityScore})
+ ({!varWeight.Service_Weight__c} * {!varServiceScore})
+ ({!varWeight.Margin_Weight__c} * 50)
+ ({!varWeight.Eco_Weight__c} * {!varEcoScore})
+ ({!varWeight.Priority_Weight__c} * 50)
))</expression>
        <scale>2</scale>
    </formulas>
